# Normalise line endings in the repository to LF.
* text=auto eol=lf

# Markdown is the primary content type here; keep diffs clean.
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary

# Collapse generated and vendored paths in diffs and language stats.
docs/** linguist-documentation
